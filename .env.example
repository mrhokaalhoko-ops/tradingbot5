# Binance API Keys (Testnet initially)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
USE_TESTNET=true
# لا تُزل التعليق إلا عند الانتقال المقصود للحساب الحقيقي مع USE_TESTNET=false:
# LIVE_TRADING_CONFIRMATION=I_ACCEPT_REAL_MONEY_RISK

# CryptoPanic API Key (News)
CRYPTOPANIC_API_KEY=your_cryptopanic_api_key_here

# HuggingFace API Key (For FinBERT Sentiment Analysis)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Telegram Bot Token & Chat ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_WEBAPP_USER_ID=your_positive_telegram_user_id_here

# Persistent runtime logs (Railway Volume is mounted at /app/data)
DATA_DIR=/app/data
STATE_FILE=/app/data/bot_state.json
TRADES_DB=/app/data/trades.db
TRADE_JOURNAL_DIR=/app/data/trade_journal
BOT_LOG_DIR=/app/data/logs
BOT_LOG_RETENTION_DAYS=7
BOT_EXPORT_TMP_DIR=/app/data/tmp
MEMORY_SAMPLE_INTERVAL_SECONDS=2
MEMORY_LOG_HIGH_WATER_STEP_MB=32
# 0 = disabled until the real Railway container limit is read from Runtime Health.
MEMORY_WARNING_MB=0
MEMORY_WARNING_COOLDOWN_SECONDS=3600
# Railway defaults to zero seconds between SIGTERM and forced SIGKILL. The
# shutdown handler needs a short window to flush state/SQLite and close sockets.
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30
BOT_CONSOLE_LOG_LEVEL=INFO
BOT_FILE_LOG_LEVEL=DEBUG
BOT_RUN_DURATION_SECONDS=0
MARK_PRICE_MAX_AGE_SECONDS=10
BOT_SINGLE_WRITER_LOCK_FILE=/app/data/trading_writer.lock
BOT_SINGLE_WRITER_WAIT_SECONDS=120
TELEGRAM_DOCUMENT_TIMEOUT_SECONDS=120
TELEGRAM_LOG_ZIP_MAX_BYTES=47185920
LUNARCRUSH_402_COOLDOWN_SECONDS=3600
BOT_STORAGE_ARCHIVE_MIN_AGE_HOURS=96
RESOURCE_AUDIT_INTERVAL_SECONDS=900
BOT_STORAGE_TEMP_ZIP_MIN_AGE_HOURS=1
# Optional; defaults to /app/data/72h_test_session.json.
BOT_72H_TEST_SESSION_FILE=/app/data/72h_test_session.json

# Optional AI/sentiment features. Keep disabled until an independent test proves value.
AUTOMATED_SENTIMENT_ENABLED=false
AI_NEWS_SENTIMENT_ENABLED=false
AI_CRITIQUE_ENABLED=false

# Execution lifecycle safety
ORDER_INTENT_RECOVERY_GRACE_SECONDS=30
SL_REPLACE_BACKOFF_SECONDS=30

# Trade-management audit flags. Strategy-affecting V2 policies remain off by
# default; notification dedup and read-only venue-confirmed UI sync are safe.
STRUCTURAL_STOP_V2_ENABLED=false
TRADE_MANAGEMENT_V2_ENABLED=false
TRADE_MANAGEMENT_V2_ACTIVATION_R=1.5
TRADE_MANAGEMENT_V2_ATR_BUFFER=0.30
TRADE_MANAGEMENT_V2_MIN_ATR_IMPROVEMENT=0.15
TRADE_MANAGEMENT_V2_MIN_RISK_IMPROVEMENT=0.10
PROTECTION_NOTIFICATION_DEDUP_ENABLED=true
LIVE_SL_UI_SYNC_ENABLED=true

# Directional extension guard (96 x 15m candles = 24h)
ENTRY_EXTENSION_LOOKBACK_BARS=96
ENTRY_MAX_DIRECTIONAL_MOVE_PCT=0.12
ENTRY_MAX_DIRECTIONAL_ATR=8.0
ENTRY_EXTENSION_RANGE_ZONE=0.75
ENTRY_CONFIRMATION_TIMEFRAME=5m
ENTRY_CONFIRMATION_LIMIT=80
ENTRY_CONFIRMATION_WINDOW_MINUTES=12
SETUP_COOLDOWN_TIMEOUT_MINUTES=60
SETUP_COOLDOWN_INVALIDATED_MINUTES=120
SETUP_COOLDOWN_STOP_MINUTES=240
SETUP_COOLDOWN_MANUAL_MINUTES=60
SETUP_COOLDOWN_TP_MINUTES=30

# Market-wide activity observer and causal fresh-continuation research.
# This path is shadow-only: it cannot create Binance orders or order intents.
HOT_LIST_SHADOW_ENABLED=true
HOT_LIST_INTERVAL_SECONDS=60
HOT_LIST_TOP_LIMIT=20
HOT_LIST_MIN_QUOTE_VOLUME_USDT=2000000
MOMENTUM_CONTINUATION_SHADOW_ENABLED=true
MOMENTUM_CONTINUATION_INTERVAL_SECONDS=60
MOMENTUM_CONTINUATION_CANDIDATE_LIMIT=8
MOMENTUM_CONTINUATION_MAX_SNAPSHOT_AGE_SECONDS=180
MOMENTUM_CONTINUATION_MAX_WAIT_BARS=3
MOMENTUM_CONTINUATION_SHADOW_HORIZON_MINUTES=240
MOMENTUM_CONTINUATION_MIN_QUOTE_VOLUME_USDT=10000000
MOMENTUM_CONTINUATION_MAX_ABS_24H_CHANGE_PCT=30
MOMENTUM_CONTINUATION_MIN_VOLUME_RATIO=1.30
MOMENTUM_CONTINUATION_ROUND_TRIP_FEE_PCT=0.0008
MOMENTUM_CONTINUATION_SLIPPAGE_PCT=0.0004

# Trading defaults for a new Demo deployment
# Stop-loss risk budget, separate from entry margin.
RISK_PER_TRADE_PERCENT=0.25
# Target margin: 1% of real equity; at 5x, notional is 5% before safety caps.
ENTRY_MARGIN_PERCENT=1
LEVERAGE=5
MAX_LEVERAGE=10
MAX_OPEN_TRADES=10
TESTNET_MAX_OPEN_TRADES=10
HARD_MAX_OPEN_TRADES=10
DYNAMIC_BLACKLIST_ACTIVE=false
DYNAMIC_BLACKLIST_MIN_TRADES=20
DAILY_LOSS_LIMIT_PERCENT=1.5
WEBAPP_URL=https://your-service.up.railway.app/
WEBAPP_PUBLIC_URL=https://your-service.up.railway.app/
